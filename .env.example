# Copy this file to .env and fill in real values before deploying.

# Random string used to sign session cookies. Any long random string works, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Generated by running: python3 generate_password.py
APP_PASSWORD_HASH=

# Optional. Lets non-browser clients (e.g. the HTTP Shortcuts app) upload to
# Reference without a real login - they send this exact value in an
# X-API-Key header. Leave blank to disable this entirely. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
API_KEY=
